<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.1.0 (20241.24.0312.1422)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='EduPredict Academic Performance Summary' inline='true' name='federated.academic_performance' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='edupredict_tableau_academic_performance' name='textscan.academic_performance'>
            <connection class='textscan' directory='.' filename='edupredict_tableau_academic_performance.csv' header='yes' separator=',' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.academic_performance' name='edupredict_tableau_academic_performance.csv' table='[edupredict_tableau_academic_performance#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='subject' ordinal='0' />
            <column datatype='string' name='academic_term' ordinal='1' />
            <column datatype='integer' name='milestone' ordinal='2' />
            <column datatype='string' name='risk_tier' ordinal='3' />
            <column datatype='string' name='distinct_students_display' ordinal='4' />
            <column datatype='integer' name='evaluation_count' ordinal='5' />
            <column datatype='real' name='avg_predicted_raw20' ordinal='6' />
            <column datatype='real' name='avg_predicted_pct' ordinal='7' />
            <column datatype='real' name='avg_coursework_final_raw20' ordinal='8' />
            <column datatype='boolean' name='suppressed' ordinal='9' />
          </columns>
        </relation>
      </connection>
    </datasource>
    <datasource caption='EduPredict Subject Trends' inline='true' name='federated.subject_trends' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='edupredict_tableau_subject_trends' name='textscan.subject_trends'>
            <connection class='textscan' directory='.' filename='edupredict_tableau_subject_trends.csv' header='yes' separator=',' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.subject_trends' name='edupredict_tableau_subject_trends.csv' table='[edupredict_tableau_subject_trends#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='academic_term' ordinal='0' />
            <column datatype='string' name='distinct_students_display' ordinal='1' />
            <column datatype='real' name='institutional_avg_raw20' ordinal='2' />
            <column datatype='real' name='math_avg_raw20' ordinal='3' />
            <column datatype='real' name='portuguese_avg_raw20' ordinal='4' />
            <column datatype='real' name='coursework_avg_raw20' ordinal='5' />
            <column datatype='real' name='verified_attendance_rate_pct' ordinal='6' />
            <column datatype='boolean' name='suppressed' ordinal='7' />
          </columns>
        </relation>
      </connection>
    </datasource>
    <datasource caption='EduPredict Attendance Summary' inline='true' name='federated.attendance_summary' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='edupredict_tableau_attendance_summary' name='textscan.attendance_summary'>
            <connection class='textscan' directory='.' filename='edupredict_tableau_attendance_summary.csv' header='yes' separator=',' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.attendance_summary' name='edupredict_tableau_attendance_summary.csv' table='[edupredict_tableau_attendance_summary#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='subject_name' ordinal='0' />
            <column datatype='string' name='subject_code' ordinal='1' />
            <column datatype='string' name='academic_term' ordinal='2' />
            <column datatype='integer' name='session_count' ordinal='3' />
            <column datatype='string' name='distinct_students_display' ordinal='4' />
            <column datatype='integer' name='present_count' ordinal='5' />
            <column datatype='integer' name='absent_count' ordinal='6' />
            <column datatype='integer' name='late_count' ordinal='7' />
            <column datatype='integer' name='excused_count' ordinal='8' />
            <column datatype='real' name='verified_attendance_rate_pct' ordinal='9' />
            <column datatype='boolean' name='suppressed' ordinal='10' />
            <column datatype='string' name='attendance_source' ordinal='11' />
          </columns>
        </relation>
      </connection>
    </datasource>
    <datasource caption='EduPredict Dropout Risk Summary' inline='true' name='federated.dropout_risk_summary' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='edupredict_tableau_dropout_risk_summary' name='textscan.dropout_risk_summary'>
            <connection class='textscan' directory='.' filename='edupredict_tableau_dropout_risk_summary.csv' header='yes' separator=',' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.dropout_risk_summary' name='edupredict_tableau_dropout_risk_summary.csv' table='[edupredict_tableau_dropout_risk_summary#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='academic_term' ordinal='0' />
            <column datatype='string' name='risk_tier' ordinal='1' />
            <column datatype='string' name='cohort_count_display' ordinal='2' />
            <column datatype='real' name='avg_risk_probability' ordinal='3' />
            <column datatype='boolean' name='suppressed' ordinal='4' />
          </columns>
        </relation>
      </connection>
    </datasource>
    <datasource caption='EduPredict Demand Forecasts' inline='true' name='federated.demand_forecast_summary' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='edupredict_tableau_demand_forecast_summary' name='textscan.demand_forecast_summary'>
            <connection class='textscan' directory='.' filename='edupredict_tableau_demand_forecast_summary.csv' header='yes' separator=',' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.demand_forecast_summary' name='edupredict_tableau_demand_forecast_summary.csv' table='[edupredict_tableau_demand_forecast_summary#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='department' ordinal='0' />
            <column datatype='string' name='subject_name' ordinal='1' />
            <column datatype='string' name='target_term' ordinal='2' />
            <column datatype='string' name='forecast_horizon' ordinal='3' />
            <column datatype='real' name='predicted_enrollment' ordinal='4' />
            <column datatype='real' name='lower_ci' ordinal='5' />
            <column datatype='real' name='upper_ci' ordinal='6' />
            <column datatype='string' name='trend_direction' ordinal='7' />
          </columns>
        </relation>
      </connection>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Academic Performance &amp; Risk'>
      <table>
        <view>
          <datasources>
            <datasource caption='EduPredict Academic Performance Summary' name='federated.academic_performance' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.academic_performance].[avg:avg_predicted_raw20:qk]</rows>
        <cols>[federated.academic_performance].[none:subject:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Multi-Term Subject Trends'>
      <table>
        <view>
          <datasources>
            <datasource caption='EduPredict Subject Trends' name='federated.subject_trends' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.subject_trends].[avg:institutional_avg_raw20:qk]</rows>
        <cols>[federated.subject_trends].[none:academic_term:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Verified Institutional Attendance'>
      <table>
        <view>
          <datasources>
            <datasource caption='EduPredict Attendance Summary' name='federated.attendance_summary' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.attendance_summary].[avg:verified_attendance_rate_pct:qk]</rows>
        <cols>[federated.attendance_summary].[none:subject_name:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Dropout Risk Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='EduPredict Dropout Risk Summary' name='federated.dropout_risk_summary' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.dropout_risk_summary].[avg:avg_risk_probability:qk]</rows>
        <cols>[federated.dropout_risk_summary].[none:risk_tier:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Course Demand Forecast'>
      <table>
        <view>
          <datasources>
            <datasource caption='EduPredict Demand Forecasts' name='federated.demand_forecast_summary' />
          </datasources>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.demand_forecast_summary].[sum:predicted_enrollment:qk]</rows>
        <cols>[federated.demand_forecast_summary].[none:target_term:nk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='EduPredict Institutional Analytics Dashboard'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='700' minwidth='1000' />
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='50000' id='2' name='Academic Performance &amp; Risk' w='50000' x='0' y='0' />
          <zone h='50000' id='3' name='Multi-Term Subject Trends' w='50000' x='50000' y='0' />
          <zone h='50000' id='4' name='Verified Institutional Attendance' w='33333' x='0' y='50000' />
          <zone h='50000' id='5' name='Dropout Risk Distribution' w='33333' x='33333' y='50000' />
          <zone h='50000' id='6' name='Course Demand Forecast' w='33334' x='66666' y='50000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
</workbook>
