# Flask Application Configuration
FLASK_APP=backend.app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Server Settings
PORT=5000
HOST=127.0.0.1

# MongoDB 6.x Configuration
MONGO_URI=mongodb://localhost:27017/edupredict
MONGO_DB_NAME=edupredict

# ML Model Paths
ML_REGRESSION_MODEL_PATH=ml_models/performance_regressor.joblib
ML_CLASSIFICATION_MODEL_PATH=ml_models/risk_classifier.joblib
ML_SCALER_PATH=ml_models/feature_scaler.joblib

# ==============================================================================
# Optional Remote Big Data Lakehouse Configuration (Apache Hadoop & Impala)
# ==============================================================================
HDFS_ENABLED=false
HDFS_NAMENODE_URL=http://localhost:9870/webhdfs/v1
HDFS_USER=edupredict

IMPALA_ENABLED=false
IMPALA_HOST=localhost
IMPALA_PORT=21050
